# Template copied by run1-5-docker.sh to student-api/.env (only if that file is missing).
# DB_* values must match the MYSQL_* values in the outer .env file.
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# "mysql" is the Compose service name, not localhost.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=studentdb
DB_USERNAME=ase230
DB_PASSWORD=ase230pass

# Same simple drivers as run1-5.sh in Module 2
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
BCRYPT_ROUNDS=12
